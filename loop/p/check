#!/usr/bin/env bash
# loop/p/check CANDIDATE OUT [BASE]: kern test of a 12-layer P manifest
# (loop/gen's p-l12.json) against BASE (default: main's, data/base/p-l12.json)
# on one leased GPU: every span replayed from A's inputs, end-to-end logits,
# the noise floor. A prefill of 6000 tokens in 2048-token chunks crosses
# chunks and pages. Last line is the verdict: PASS / FAIL / INCONCLUSIVE.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../env.sh"
cand=$(realpath "$1") out=$(realpath -m "$2") base=$(realpath "${3:-$K3_LOOP_DATA/base/p-l12.json}")
mkdir -p "$(dirname "$out")"
# kern test diffs ops, not cubins: a module whose bytes changed under the same
# name would read as "nothing to test". Renaming it in the candidate makes
# every op on it a changed implementation, replayed span by span.
python3 - "$base" "$cand" "$out.cand.json" <<'PY'
import json, sys
base, cand = (json.load(open(p)) for p in sys.argv[1:3])
changed = {k for k, m in cand["modules"].items() if k in base["modules"] and base["modules"][k]["sha256"] != m["sha256"]}
cand["modules"] = {(k + "+candidate" if k in changed else k): m for k, m in cand["modules"].items()}
for op in cand["ops"].values():
    for l in op["impl"]["launches"]:
        if l.get("module") in changed:
            l["module"] += "+candidate"
json.dump(cand, open(sys.argv[3], "w"))
print("modules changed in place:", ", ".join(sorted(changed)) or "none")
PY
cand=$out.cand.json
cd "$LOOP_DIR"  # kern reads a kern.toml in the cwd
"$LOOP_DIR/withgpu" -n 1 env KERN_CACHE_DIR="$KERN_CACHE_DIR" LD_LIBRARY_PATH="$LD_LIBRARY_PATH" "$K3_KERN_BIN" test --reference "$base" --manifest "$cand" --kernels "$REPO/build" \
  --weights "$K3_WEIGHTS" --tokenizer "$K3_TOKENIZER" --gpu 0 --capacity 16384 --prefill 6000 --chunk 2048 \
  --out "$out.json" > "$out.log" 2>&1
rc=$?
grep -E "^(local|logits|noise|perf|PASS|FAIL|INCONCLUSIVE)" "$out.log" | cut -c1-400
exit $rc
