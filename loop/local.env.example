# Machine paths for loop/ scripts; copy to loop/local.env (not tracked) and fill in.
K3_KERN=<kern checkout on the pd-agentx line: tools/ for the generator>
KERN_INDEX_DIR=<kern-kernels>/index
K3_KERN_BIN=<kern CLI of that checkout: bench / test / cut / verify>
K3_STEP_BIN=<step/ (k3_step) built against that checkout>
K3_WEIGHTS=<full Kimi-K3 HF checkpoint, 896 experts>
K3_TOKENIZER=<tokenizer.json of that checkpoint>
K3_NCCL_LIB=<dir with NCCL 2.30.7, including an unversioned libnccl.so>
K3_NCCL_IFNAME=<socket interface NCCL bootstraps over>
K3_NVCC=<nvcc 13.0.88, the one kernels.toml was pinned with>
KERN_CACHE_DIR=<shared, content-addressed kernel cache (blobs/<sha256>)>
K3_LOOP_DATA=<shared dir: base references, token files, per-run outputs>
WITHGPU_HOSTS=${WITHGPU_HOSTS:-"<hosts of the GPU pool>"}
K3_REF=<dir of read-only reference sources for the agents: sglang, vllm, flashinfer, trtllm, DeepGEMM, nvkda, insights.md>
WITHGPU_HOST_FORMAT=<printf format from a pool name to an ssh host, e.g. %s.cluster>
K3_SHARED=<shared filesystem mounted read-only into the agents' container>
